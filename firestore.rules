rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /movements/{movementId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['agentId', 'agentName', 'type', 'signedHours', 'note', 'createdAt', 'createdBy', 'createdByEmail'])
        && request.resource.data.keys().hasOnly(['agentId', 'agentName', 'type', 'signedHours', 'note', 'createdAt', 'createdBy', 'createdByEmail'])
        && request.resource.data.agentId is string
        && request.resource.data.agentName is string
        && request.resource.data.type in ['favor', 'deuda']
        && request.resource.data.signedHours is number
        && request.resource.data.signedHours != 0
        && request.resource.data.signedHours >= -24
        && request.resource.data.signedHours <= 24
        && ((request.resource.data.type == 'favor' && request.resource.data.signedHours > 0)
          || (request.resource.data.type == 'deuda' && request.resource.data.signedHours < 0))
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 180
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail is string;
      allow update, delete: if false;
    }
  }
}
