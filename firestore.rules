rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authorizedAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'jmjuarez@upana.edu.gt',
          'nozuna@upana.edu.gt',
          'ccoyoy@upana.edu.gt'
        ];
    }

    function knownAgent(agentId) {
      return agentId in [
        '8001', '8002', '8003', '8004', '8005', '8007', '8008', '8009', '8010',
        '8011', '8013', '8014', '8016', '8017', '8018', '8020', '8021', '8022',
        '8023', '8024', '8025', '8026', '8027', '8028', '8029'
      ];
    }

    match /hourRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll([
          'agentId', 'requestType', 'eventAt', 'durationMinutes', 'reason',
          'contactName', 'contactEmail', 'contactPhone', 'status', 'submittedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'agentId', 'requestType', 'eventAt', 'durationMinutes', 'reason',
          'contactName', 'contactEmail', 'contactPhone', 'status', 'submittedAt'
        ])
        && knownAgent(request.resource.data.agentId)
        && request.resource.data.requestType in ['favor', 'recuperacion']
        && request.resource.data.eventAt is timestamp
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 1
        && request.resource.data.durationMinutes <= 1440
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 8
        && request.resource.data.reason.size() <= 500
        && request.resource.data.contactName is string
        && request.resource.data.contactName.size() <= 100
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() <= 180
        && request.resource.data.contactPhone is string
        && request.resource.data.contactPhone.size() <= 40
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt == request.time
        && ((request.resource.data.requestType == 'favor' && request.resource.data.eventAt <= request.time)
          || (request.resource.data.requestType == 'recuperacion'
            && request.resource.data.eventAt <= request.time + duration.value(180, 'd')));
      allow get, list: if authorizedAdmin();
      allow update, delete: if false;
    }

    match /movements/{movementId} {
      allow read: if authorizedAdmin();
      allow create: if authorizedAdmin()
        && request.resource.data.keys().hasAll([
          'agentId', 'type', 'signedMinutes', 'durationMinutes', 'eventAt',
          'note', 'createdAt', 'createdBy', 'createdByEmail'
        ])
        && request.resource.data.keys().hasOnly([
          'agentId', 'type', 'signedMinutes', 'durationMinutes', 'eventAt',
          'note', 'createdAt', 'createdBy', 'createdByEmail'
        ])
        && knownAgent(request.resource.data.agentId)
        && request.resource.data.type in ['favor', 'deuda']
        && request.resource.data.signedMinutes is int
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 1
        && request.resource.data.durationMinutes <= 1440
        && request.resource.data.signedMinutes != 0
        && ((request.resource.data.type == 'favor'
            && request.resource.data.signedMinutes == request.resource.data.durationMinutes)
          || (request.resource.data.type == 'deuda'
            && request.resource.data.signedMinutes == -request.resource.data.durationMinutes))
        && request.resource.data.eventAt is timestamp
        && request.resource.data.eventAt <= request.time
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email;
      allow update, delete: if false;
    }
  }
}
